{
	// The build-time scripts, which the app's own tsconfig does not reach:
	// it extends .svelte-kit/tsconfig.json, whose `include` covers only src,
	// test, tests and vite.config. That gap let type errors accumulate in
	// scripts/ unnoticed, since nothing ever checked them.
	//
	// Kept as a second project rather than widened into tsconfig.json because
	// overriding `include` there would replace SvelteKit's generated list
	// wholesale, and it is regenerated by `svelte-kit sync`.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": ["scripts/**/*.ts", "bin/**/*.ts"]
}
