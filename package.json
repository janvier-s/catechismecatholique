{
	"name": "lecatechisme",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"predev": "tsx scripts/prepare-data.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare-data": "tsx scripts/prepare-data.ts",
		"upload-index": "tsx scripts/upload-index.ts",
		"prebuild": "tsx scripts/prepare-data.ts",
		"optimize-logos": "tsx bin/optimize-logos.ts",
		"generate-og-image": "node scripts/generate-og-image.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^20",
		"@types/xml2js": "^0.4.14",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"parse5": "^8.0.1",
		"postcss": "^8.5.13",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"xml2js": "^0.6.2"
	},
	"dependencies": {
		"minisearch": "^7.2.0"
	}
}
