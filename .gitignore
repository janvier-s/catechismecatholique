# Generated data — committed so CI / Cloudflare Pages builds work without
# the per-developer source symlinks. `npm run prepare-data` rebuilds it
# locally; the result is tracked. Only the iCloud-collision sibling
# (e.g. "static/data 2") used by bin/use-local-data-cache.sh stays ignored.
/static/data?*

# Negate any global ignore (e.g. `parts/`) for tracked compendium bundles.
!/static/data/compendium/parts/
!/static/data/compendium/parts/*.json

