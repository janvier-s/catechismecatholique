{"corpus":"ccc","number":658,"text_html":"<span><i class=\"typo_italic\">Le Christ, « premier né d’entre les morts » <sup class=\"srcRef bibleRef\" data-idx=\"1\">1</sup>, est le principe de notre propre résurrection, dès maintenant par la justification de notre âme <sup class=\"srcRef bibleRef\" data-idx=\"2\">2</sup>, plus tard par la vivification de notre corps <sup class=\"srcRef bibleRef\" data-idx=\"3\">3</sup>.</i></span>","cross_refs":[],"bible_refs":[{"text":"Col 1:18"},{"text":"Rm 6:4"},{"text":"Rm 8:11"}],"citations":[],"magisterial_refs":[{"type":"bible","raw":"Col 1:18","idx":1},{"type":"bible","raw":"voir Rm 6:4","idx":2},{"type":"bible","raw":"voir Rm 8:11","idx":3}]}